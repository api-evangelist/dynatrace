          "id": "84806ba9-904f-4bf2-8b42-c194ea80ec61",
          "name": "Dynatrace List Permissions for Account",
          "request": {
            "name": "Dynatrace List Permissions for Account",
            "description": {
              "content": "Returns a list of all permissions defined for the account. Permissions control what actions groups and users can perform within Dynatrace environments and at the account level. Results include both environment-scoped and account-scoped permissions.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "iam",
                "v1",
                "accounts",
                ":accountUuid",
                "permissions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "accountUuid",
                  "description": "(Required) The UUID of the Dynatrace account. Found in the Dynatrace account settings or obtained from the account API."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
