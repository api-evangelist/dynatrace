          "name": "Dynatrace List Environments",
          "request": {
            "name": "Dynatrace List Environments",
            "description": {
              "content": "Returns a list of all Dynatrace environments associated with the specified account. Each environment record includes the environment ID, name, and URL. This information is useful for enumerating environments before making environment-level API calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "env",
                "v1",
                "accounts",
                ":accountUuid",
                "environments"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "nextPageKey",
                  "value": "<string>",
                  "description": "Cursor for the next page of results."
                },
                {
                  "disabled": false,
                  "key": "pageSize",
                  "value": "100",
                  "description": "The number of environments to return per page."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "accountUuid",
                  "description": "(Required) The UUID of the Dynatrace account. Found in the Dynatrace account settings or obtained from the account API."
                }
              ]
            },
            "header": [
